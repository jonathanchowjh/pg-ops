{
  "name": "pgops",
  "version": "0.0.0",
  "description": "Modern Postgres on-call ops toolkit for your terminal. Run it during the incident.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "pgops": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:up": "./scripts/dev-db.sh up",
    "db:down": "./scripts/dev-db.sh down",
    "db:psql": "./scripts/dev-db.sh psql",
    "db:seed": "./scripts/dev-db.sh seed"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "tui",
    "cli",
    "ops",
    "dba",
    "locks",
    "incident",
    "sre"
  ],
  "dependencies": {
    "ink": "^5.1.0",
    "pg": "^8.13.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
